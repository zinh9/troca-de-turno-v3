<?xml version="1.0" encoding="UTF-8"?>
<!-- Opcional: com o módulo "URL Rewrite" do IIS, /api/painel passa a funcionar sem escrever index.php na URL. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="TrocaDeTurnoApi" stopProcessing="true">
          <match url="^api/.*" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
